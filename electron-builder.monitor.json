{
  "appId": "kr.co.bewe.missionmonitor",
  "productName": "BEWE Mission Monitor",
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "extraMetadata": {
    "main": "monitor-main.js"
  },
  "directories": {
    "output": "release/monitor"
  },
  "files": [
    "monitor-main.js",
    "monitor-preload.js",
    "monitor-connect.html",
    "assets/**/*"
  ],
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "AudioVideo",
    "icon": "assets/icon.png"
  },
  "win": {
    "target": [
      "portable"
    ],
    "icon": "assets/icon.png",
    "signAndEditExecutable": false
  }
}
